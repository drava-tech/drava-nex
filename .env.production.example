# Production configuration. Copy to .env.production (never commit it) and fill in.
# Used both by docker compose (--env-file) and by the api container (env_file).

# ─── Public address ──────────────────────────────────────────────────────────
# The host name people and screens use, e.g. push.example.com.
PUBLIC_HOST=push.example.com
# Where nginx listens on this machine. 80 behind a router port-forward, or any
# free port when only the Cloudflare Tunnel reaches it.
HTTP_PORT=80
# The full origin, https when fronted by Cloudflare. Must match what browsers use.
APP_URL=https://push.example.com
BETTER_AUTH_URL=https://push.example.com

# ─── Database (the postgres service) ─────────────────────────────────────────
POSTGRES_USER=push
POSTGRES_DB=push
# openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# ─── Secrets ─────────────────────────────────────────────────────────────────
# openssl rand -hex 32   (each)
BETTER_AUTH_SECRET=CHANGE_ME
UPLOAD_TICKET_SECRET=CHANGE_ME

# ─── Cloudflare R2 ───────────────────────────────────────────────────────────
# A bucket and an API token dedicated to this product (Object Read & Write on
# this bucket only).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=push-media
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
# Recommended: a public custom domain bound to the bucket, so screens stream
# from Cloudflare's edge with stable URLs. Unset = private bucket, served via
# /api/media/:id/file redirects to short-lived signed URLs.
R2_PUBLIC_BASE_URL=https://media.example.com
MAX_UPLOAD_BYTES=5368709120

# The bucket's CORS policy (R2 → Settings → CORS) must be:
# [{ "AllowedOrigins": ["https://push.example.com"],
#    "AllowedMethods": ["GET", "PUT", "HEAD"],
#    "AllowedHeaders": ["content-type", "cache-control"],
#    "ExposeHeaders": ["ETag", "Content-Length", "Content-Range", "Accept-Ranges"],
#    "MaxAgeSeconds": 3600 }]
# cache-control MUST be listed: it is not CORS-safelisted, and without it every
# upload fails with a generic CORS error while the preflight looks fine.

# ─── Cloudflare Tunnel (only with --profile tunnel) ─────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=
