# Rendered by the nginx image at start: ${PUBLIC_HOST} comes from the
# environment. nginx's own $variables are left alone (only defined environment
# variables are substituted).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# The real client address. Behind a Cloudflare Tunnel every request arrives
# from the cloudflared container, which would make the pairing rate limit treat
# the whole internet as one client, so Cloudflare's CF-Connecting-IP is used —
# but ONLY from the dedicated tunnel network (see docker-compose.yml), where
# cloudflared is the sole other member. Traffic through the published port
# arrives from a different network and keeps its socket address, so a client
# cannot dodge the rate limit by sending its own CF-Connecting-IP.
set_real_ip_from 172.31.254.0/24;
real_ip_header CF-Connecting-IP;

# Anything not addressed to our host name is dropped without a response.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name ${PUBLIC_HOST} localhost;

    root /usr/share/nginx/html;

    # Uploads go browser → storage directly and never pass through here.
    client_max_body_size 1m;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # nginx's stock mime.types has no .mjs, so the pdf.js worker would go out as
    # application/octet-stream — and with nosniff the browser refuses to run it
    # as a module worker, breaking every PDF. (Vite's dev server hides this.)
    location ~* ^/assets/.+\.mjs$ {
        types { }
        default_type text/javascript;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        try_files $uri =404;
    }

    # Vite's hashed build output: safe to cache forever.
    location /assets/ {
        # A location with its own add_header drops the server-level ones, so the
        # security headers are repeated wherever a location sets a header.
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        try_files $uri =404;
    }

    # The SPA. index.html is never cached, so a deploy is picked up on the next
    # load (long-running displays: send RELOAD from the console).
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        try_files $uri /index.html;
    }

    location /api/ {
        proxy_pass http://api:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /ws {
        proxy_pass http://api:4000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Displays hold one socket for days; the gateway's 30 s heartbeat
        # keeps it busy well inside this.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location = /health {
        proxy_pass http://api:4000/health;
    }
}
