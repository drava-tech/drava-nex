# ─── Screens app env (local dev) ──────────────────────────────────────────────
# Copy to apps/screens/.env.local :  cp apps/screens/.env.example apps/screens/.env.local

# Browser-facing URLs stay relative so LAN displays connect back through Nginx.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WS_GATEWAY_URL=/ws

# Set this when opening screens through http://<host>/display/<screenId>.
# Leave unset only when running the screens app directly at http://localhost:3001/<screenId>.
NEXT_PUBLIC_SCREENS_BASE_PATH=/display

INTERNAL_API_URL=http://localhost:4000
