BROADCAST_SECRET=your-secret-here

SCREEN_AGENT_WS_URL=ws://ec-cms/ws/

# This exact PC's own screenId — must match the screenId segment of the kiosk
# Chrome URL running on THIS machine, e.g. chrome.exe --kiosk ".../display/main-TV"
# means SCREEN_ID=main-TV. Every PC driving a different screen needs its own
# SCREEN_ID, matching its own kiosk URL.
SCREEN_ID=main-TV

# Uncomment while diagnosing a cursor problem: logs every mouse-move the agent
# applies, to agent.log. Off by default — it fires hundreds of times a second
# during a drag and would otherwise dominate the log.
# SCREEN_AGENT_DEBUG=1
