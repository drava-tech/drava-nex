# Must match BROADCAST_SECRET in the root .env.production (used by cms-api) —
# this is how the gateway authenticates the bridge's AUDIO_BRIDGE_REGISTER.
BROADCAST_SECRET=your-secret-here

# WS gateway URL — the same published nginx endpoint the live-stream publisher
# EXE already connects to from outside Docker.
AUDIO_BRIDGE_WS_URL=ws://192.168.0.250/ws/

# Optional: pin audio-helper.exe to one or more specific playback devices by
# (partial, case-insensitive) name — comma separated — instead of trusting
# whatever Windows currently calls "default". The OS default can silently
# drift (HDMI reconnects, driver updates, reboots) to a device that isn't
# actually wired to the speakers. All listed devices get the same
# volume/mute; the CMS UI shows one number/slider driven from the first one.
# Leave unset to keep following the OS default (single device). Check
# Settings > Sound, or `/api/audio/status`'s "device" field, for exact names.
# TARGET_DEVICE_NAMES=Realtek Digital Output,WAF
