# ─── CMS app env (local dev) ──────────────────────────────────────────────────
# Copy to apps/cms/.env :  cp apps/cms/.env.example apps/cms/.env
#
# NOTE: DATABASE_URL is NOT needed here — @platform/db loads it from the root .env
# automatically (packages/db/src/client.ts). Set the DB connection in root .env.

NODE_ENV=development

# Better Auth — REQUIRED. Generate your own: openssl rand -hex 32
BETTER_AUTH_SECRET=<GENERATE_WITH_openssl_rand_-hex_32>
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public URLs — absolute localhost so dev works without the nginx proxy
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
NEXT_PUBLIC_WS_GATEWAY_URL=ws://localhost:4000/ws

# Internal CMS → API calls + broadcast (must match the API's BROADCAST_SECRET)
INTERNAL_API_URL=http://localhost:4000
BROADCAST_SECRET=dev-secret
