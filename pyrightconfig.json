{
  "venvPath": "services/vision",
  "venv": ".venv",
  "pythonVersion": "3.11",
  "pythonPlatform": "Windows",
  "extraPaths": [
    "services"
  ],
  "include": [
    "services/vision"
  ],
  "exclude": [
    ".git",
    "**/.venv",
    "**/.venv-object",
    "**/.venv-test",
    "**/.venv.old",
    "services/vision/data",
    "services/vision/models",
    "node_modules"
  ],
  "typeCheckingMode": "basic",
  "reportMissingModuleSource": "none"
}
