# Dependency directories
node_modules/
.pnpm-debug.log*

# Next.js build outputs
.next/
out/

# TypeScript build outputs
dist/
*.tsbuildinfo

# .NET build outputs (tools/main-screen-kiosk)
tools/main-screen-kiosk/bin/
tools/main-screen-kiosk/obj/

# Android build outputs (tools/cms-android). The generated android/ project is
# committed on purpose — it carries the network security config, the manifest
# edits and the Gradle signing block — but its build artefacts are not.
tools/cms-android/node_modules/
tools/cms-android/android/build/
tools/cms-android/android/app/build/
tools/cms-android/android/capacitor-cordova-android-plugins/build/
tools/cms-android/android/.gradle/
tools/cms-android/android/.idea/
tools/cms-android/android/local.properties
# Release signing credentials and keystores — never commit these.
tools/cms-android/android/keystore.properties
*.jks
*.keystore

# Environmental variables
.env
.env.local
.env.development.local
.env.test.local
.env.production
.env.production.local

# IDE configurations
.vscode/
.idea/

# OS specific files
.DS_Store
Thumbs.db

# Turborepo caches and logs
.turbo/

# PostgreSQL data (bind-mounted in docker-compose.yml MODE B)
postgres-data/

# Runtime data directories (keep outside the repo)
uploads/
logs/

# Backup files
backups/
*.backup
*.dump
*.sql.gz
# Root-level DB dumps (NOT the drizzle migrations under packages/db/drizzle/*.sql)
/backup_*.sql
/*.dump.sql

infra/nginx/certs/

# ─── Vision Service (services/vision) ──────────────────────────────────────────
# Virtual environments — the face (requirements.txt) and object-detection
# (requirements-object.txt) venvs are separate processes/envs by design (see
# services/vision/README.md); any of these names may exist depending on how
# a given machine set them up.
.venv/
.venv-test/
.venv.old/
.venv-object/
cms_env/

# Object-detection (mat product detector) trained weights — promote to
# production manually; store with Git LFS or DVC instead of committing here.
services/vision/models/**/*.pt
services/vision/models/**/*.onnx
services/vision/models/**/*.engine
services/product-vision/models/**/*.pt
services/product-vision/models/**/*.onnx
services/product-vision/models/**/*.engine

# Calibrated mat ROI + any other machine-local runtime data (see mat_roi.py,
# scripts/calibrate_mat.py) — physical-setup-specific, not portable.
services/vision/data/

# Face-recognition model packs are downloaded locally by InsightFace.
services/models/
services/vision/models/**/*.zip
services/vision/models/**/1k3d68.onnx
services/vision/models/**/2d106det.onnx
services/vision/models/**/det_10g.onnx
services/vision/models/**/genderage.onnx
services/vision/models/**/w600k_r50.onnx

# Python cache
**/__pycache__/
**/*.pyc
**/*.pyo

# NOT ignored (committed): .py sources, requirements.txt, Dockerfile,
# README.md, .env.example, data.yaml, .gitkeep placeholder files

# Local staging/backup copy of services/vision (model weights, .env, mat data) —
# not under services/, so the rules above don't reach it; ignore wholesale.
/gitignored-object-detection/

# Helper runtime logs (screen-agent, audio bridge, vision) — self-rotating,
# never useful in git. See .doc/device-setup.md "Screen PC helpers".
*.log
*.log.1
