/*.dump.sql

infra/nginx/certs/

# ─── Product Vision Service (Python) ─────────────────────────────────────────
# Virtual environment
services/product-vision/.venv/
services/product-vision/.venv.old/
.venv/
.venv.old/

# Raw captured training images (can be hundreds of MB — store externally or in DVC)
services/product-vision/datasets/*/raw/positive/
services/product-vision/datasets/*/raw/background/

# Split images and YOLO label files (regenerated by split_dataset.py)
services/product-vision/datasets/*/images/
services/product-vision/datasets/*/labels/

# Ultralytics training outputs
services/product-vision/runs/

# Test/prediction output images
services/product-vision/predictions/

# Trained model weights (promote to production manually; store with Git LFS or DVC)
services/product-vision/models/**/*.pt
services/product-vision/models/**/*.onnx
services/product-vision/models/**/*.engine

# Face-recognition model packs are downloaded locally by InsightFace.
services/models/
services/vision/models/**/*.zip
services/vision/models/**/1k3d68.onnx
services/vision/models/**/2d106det.onnx
services/vision/models/**/det_10g.onnx
services/vision/models/**/genderage.onnx
services/vision/models/**/w600k_r50.onnx

# Python cache
**/__pycache__/
**/*.pyc
**/*.pyo

# NOT ignored (committed): .py sources, requirements.txt, Dockerfile,
# README.md, .env.example, data.yaml, .gitkeep placeholder files
