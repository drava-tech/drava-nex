# ─── Node Environment ─────────────────────────────────────────────────────────
NODE_ENV=production

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Docker mode  : host = postgres  (Docker service name)
# Local dev    : host = localhost (Windows native PostgreSQL)
POSTGRES_DB=cms_db
POSTGRES_USER=cms_app
POSTGRES_PASSWORD=CHANGE_ME

DATABASE_URL=postgresql://cms_app:CHANGE_ME@postgres:5432/cms_db

# ─── API Configuration ──────────────────────────────────────────────────────────
# Detection minimum confidence threshold
DETECTION_MIN_CONFIDENCE="0.7"

# Camera to screen ID mapping (format: cameraId:screenId,cameraId:screenId)
# camera-01/02 (RealSense 1/2) are wired to the main-screen kiosk PC; the
# Product Showcase experience picks which one feeds detection. camera-03
# (tablet camera) isn't wired here yet — add it once its screenId is known.
CAMERA_SCREEN_MAP="camera-01:main-screen,camera-02:main-screen"

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=CHANGE_ME
# The SINGLE public origin the browser uses (nginx). Use your LAN host/domain in
# prod, e.g. http://192.168.0.250 — must match how users open the app.
BETTER_AUTH_URL=http://localhost
NEXT_PUBLIC_APP_URL=http://localhost

# ─── Next.js Public URLs (baked in at Next.js build time) ────────────────────
# Single origin: everything is same-origin relative; nginx routes /api and /ws
# to the API and /display to the CMS.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WS_URL=/ws
NEXT_PUBLIC_WS_GATEWAY_URL=/ws
# Base of the screens player for the CMS live-mirror iframe (Docker/Nginx: /display)
NEXT_PUBLIC_SCREENS_URL=/display

# ─── CORS / MQTT Broker ───────────────────────────────────────────────────────
# CORS_ORIGIN = the single public origin (comma-separated if you add a LAN host,
# e.g. http://localhost,http://192.168.0.250). Behind nginx /api is same-origin.
CORS_ORIGIN=http://localhost
# MQTT — Docker: mqtt://mosquitto:1883 ; Local dev: mqtt://localhost:1883
MQTT_BROKER_URL=mqtt://mosquitto:1883
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_WS_PORT=9001

# ─── Casambi Lithernet Gateway ────────────────────────────────────────────────
# Casambi network ID as seen in the gateway's MQTT topics (casambi/<id>/...).
CASAMBI_NETWORK_ID=5
# The physical gateway isn't in Docker, so it can't reach the mosquitto:1883
# hostname — point it at the host's LAN address instead in the gateway's own
# admin UI: mqtt://192.168.0.250:1883 (mosquitto already publishes 1883 to the
# host for this). Do NOT set MQTT_BROKER_URL above to this LAN address — that
# var is read by cms-api itself, which is on the Docker-internal network and
# must keep using mqtt://mosquitto:1883, or it loses its own MQTT connection.

# ─── IR Devices (CrabController Tuya IR bridge) ───────────────────────────────
# The CrabController service (python -m ir_controller.service) must run against
# the SAME MQTT_BROKER_URL above. Set IR_ENABLED to turn on the ack/status
# ingest; topics default to the bridge's fixed contract and rarely change.
IR_ENABLED=true
IR_COMMAND_TOPIC=twt/av/ir/command
IR_ACK_TOPIC=twt/av/ir/ack
IR_STATUS_TOPIC=twt/av/ir/status
# Direct HTTP endpoint of the CrabController webapp (POST /command). Used by the
# CMS header AC on/off button. Local dev: the bridge on the same host.
CRABCONTROLLER_URL=http://localhost:8000

# ─── Screen Player ────────────────────────────────────────────────────────────
SCREEN_ID=screen_experience_center_01

# ─── File Storage ─────────────────────────────────────────────────────────────
# Docker mode  : container paths  →  /data/uploads  /data/logs
# Local dev    : Windows paths    →  E:/EC/cms-platform-data/uploads
UPLOAD_DIR=/data/uploads
LOG_DIR=/data/logs

# ─── Real-Time Broadcast ──────────────────────────────────────────────────────
# Shared secret between CMS and API for internal broadcast calls
# Generate with: openssl rand -hex 32
BROADCAST_SECRET=CHANGE_ME

# URL the CMS uses to reach the API internally (server-to-server, NOT browser).
# Docker mode  : http://api:4000  (Docker service name)
# Local dev    : http://localhost:4000
INTERNAL_API_URL=http://localhost:4000

# ─── Yale Lock Webhook (IFTTT → MQTT bridge) ─────────────────────────────────
# Hardware ID (serial) of the Yale Zuri S; requests with any other lockId → 401.
YALE_LOCK_ID=C8WK7004R2
# Shared secret IFTTT appends as ?token=… (IFTTT cannot set custom headers).
# Generate with: openssl rand -hex 32
YALE_WEBHOOK_TOKEN=CHANGE_ME

# ─── Vision Inference Server ──────────────────────────────────────────────────
# WebSocket endpoint for vision inference
NEXT_PUBLIC_VISION_WS_URL=/vision/ws

# Environment variables for vision-inference service (if active)
VISION_SERVER_MODEL_PATH=/app/models/production/coster-v1.pt
VISION_SERVER_DEVICE=cuda:0
VISION_SERVER_CONF_THRESHOLD=0.4

# ─── Home Assistant (Yale lock event source) ───────────────────────────────
HA_URL=http://localhost:8123
HA_TOKEN=CHANGE_ME
HA_ENTITY_ID=lock.front_door
