# ─── Node Environment ─────────────────────────────────────────────────────────
NODE_ENV=production

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Docker mode  : host = postgres  (Docker service name)
# Local dev    : host = localhost (Windows native PostgreSQL)
POSTGRES_DB=cms_db
POSTGRES_USER=cms_app
POSTGRES_PASSWORD=CHANGE_ME

DATABASE_URL=postgresql://cms_app:CHANGE_ME@postgres:5432/cms_db

# ─── API Configuration ──────────────────────────────────────────────────────────
# Detection minimum confidence threshold
DETECTION_MIN_CONFIDENCE="0.7"

# Camera to screen ID mapping (format: cameraId:screenId,cameraId:screenId)
CAMERA_SCREEN_MAP="camera-01:main-screen"

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=CHANGE_ME
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── App Ports ────────────────────────────────────────────────────────────────
API_PORT=4000
CMS_PORT=3000
SCREENS_PORT=3001

# ─── Next.js Public URLs (baked in at Next.js build time) ────────────────────
# Docker mode  : relative paths through Nginx  →  /api  /ws
# Local dev    : direct app URLs               →  http://localhost:4000
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WS_URL=/ws
NEXT_PUBLIC_WS_GATEWAY_URL=/ws
# Base of the screens player for the CMS live-mirror iframe (Docker/Nginx: /display)
NEXT_PUBLIC_SCREENS_URL=/display

# ─── MQTT Broker ──────────────────────────────────────────────────────────────
# Docker mode  : mqtt://mosquitto:1883  (Docker service name)
# Local dev    : mqtt://localhost:1883
CORS_ORIGIN=http://192.168.1.100,http://localhost
MQTT_BROKER_URL=mqtt://mosquitto:1883
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_WS_PORT=9001

# ─── Screen Player ────────────────────────────────────────────────────────────
SCREEN_ID=screen_experience_center_01

# ─── File Storage ─────────────────────────────────────────────────────────────
# Docker mode  : container paths  →  /data/uploads  /data/logs
# Local dev    : Windows paths    →  E:/EC/cms-platform-data/uploads
UPLOAD_DIR=/data/uploads
LOG_DIR=/data/logs

# ─── Real-Time Broadcast ──────────────────────────────────────────────────────
# Shared secret between CMS and API for internal broadcast calls
# Generate with: openssl rand -hex 32
BROADCAST_SECRET=CHANGE_ME

# URL the CMS uses to reach the API internally
# Docker mode  : http://api:4000  (Docker service name)
# Local dev    : http://localhost:4000
INTERNAL_API_URL=http://localhost:4000

# Path to the screens config directory (used by API in Docker)
# Docker mode  : /app/apps/screens/public/config  (matches volume mount)
# Local dev    : auto-detected from cwd (leave blank)
# CONFIG_DIR=/app/apps/screens/public/config
