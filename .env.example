# ─── PostgreSQL (connection string) ──────────────────────────────────────────
DATABASE_URL="postgresql://cms_app:CHANGE_ME@localhost:5432/cms_db"

# ─── PostgreSQL (individual components — used by docker-compose.yml MODE B) ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cms_db
POSTGRES_USER=cms_app
POSTGRES_PASSWORD=CHANGE_ME

# ─── MQTT Broker ──────────────────────────────────────────────────────────────
MQTT_BROKER_URL="mqtt://localhost:1883"
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_USERNAME=""
MQTT_PASSWORD=""

# ─── App Ports ────────────────────────────────────────────────────────────────
API_PORT=4000
CMS_PORT=3000
SCREENS_PORT=3001

# ─── Next.js Public URLs (used in browser — must start with NEXT_PUBLIC_) ────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="ws://localhost:4000/ws"
NEXT_PUBLIC_WS_GATEWAY_URL="ws://localhost:4000/ws"

# ─── Screen Player ────────────────────────────────────────────────────────────
SCREEN_ID="screen_experience_center_01"

# ─── File Storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR="E:/EC/cms-platform-data/uploads"
LOG_DIR="E:/EC/cms-platform-data/logs"
