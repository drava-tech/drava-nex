# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://push:push@localhost:5433/push

# ─── API ─────────────────────────────────────────────────────────────────────
PORT=4000
# Public origin the browser uses (console + API are served same-origin).
APP_URL=http://localhost:3000

# ─── Auth (better-auth) ──────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=CHANGE_ME
BETTER_AUTH_URL=http://localhost:3000

# HMAC key for upload tickets (presign → commit). openssl rand -hex 32
UPLOAD_TICKET_SECRET=CHANGE_ME

# ─── Cloudflare R2 ───────────────────────────────────────────────────────────
# A bucket and API token dedicated to this product — never share another
# product's bucket. The token only needs Object Read & Write on this bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=push-media
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
# Public custom domain bound to the bucket (e.g. https://media.example.com).
# Unset = screens fetch through GET /api/media/:id/file (302 to a presigned URL).
R2_PUBLIC_BASE_URL=
# The bucket CORS policy must allow this app's origin: GET/PUT/HEAD, with
# AllowedHeaders content-type AND cache-control (cache-control is not
# CORS-safelisted — leave it out and uploads fail with a generic CORS error).

MAX_UPLOAD_BYTES=5368709120
