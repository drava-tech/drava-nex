# ─── Node Environment ─────────────────────────────────────────────────────────
NODE_ENV=production

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Docker mode  : host = postgres  (Docker service name)
# Local dev    : host = localhost (Windows native PostgreSQL)
POSTGRES_DB=cms_db
POSTGRES_USER=cms_app
POSTGRES_PASSWORD=CHANGE_ME

DATABASE_URL=postgresql://cms_app:CHANGE_ME@postgres:5432/cms_db

# ─── App Ports ────────────────────────────────────────────────────────────────
API_PORT=4000
CMS_PORT=3000
SCREENS_PORT=3001

# ─── Next.js Public URLs (baked in at Next.js build time) ────────────────────
# Docker mode  : relative paths through Nginx  →  /api  /ws
# Local dev    : direct app URLs               →  http://localhost:4000
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WS_URL=/ws
NEXT_PUBLIC_WS_GATEWAY_URL=/ws

# ─── MQTT Broker ──────────────────────────────────────────────────────────────
# Docker mode  : mqtt://mosquitto:1883  (Docker service name)
# Local dev    : mqtt://localhost:1883
CORS_ORIGIN=http://192.168.1.100,http://localhost
MQTT_BROKER_URL=mqtt://mosquitto:1883
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_WS_PORT=9001

# ─── Screen Player ────────────────────────────────────────────────────────────
SCREEN_ID=screen_experience_center_01

# ─── File Storage ─────────────────────────────────────────────────────────────
# Docker mode  : container paths  →  /data/uploads  /data/logs
# Local dev    : Windows paths    →  E:/EC/cms-platform-data/uploads
UPLOAD_DIR=/data/uploads
LOG_DIR=/data/logs
