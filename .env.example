NODE_ENV=production

POSTGRES_DB=cms_db
POSTGRES_USER=cms_app
POSTGRES_PASSWORD=CHANGE_ME

DATABASE_URL=postgresql://cms_app:CHANGE_ME@postgres:5432/cms_db

DETECTION_MIN_CONFIDENCE="0.7"

# Camera to screen ID mapping (format: cameraId:screenId,cameraId:screenId)
# camera-01/02 (RealSense 1/2) are wired to the main-screen kiosk PC; the
# Product Showcase experience picks which one feeds detection. camera-03
# (tablet camera) isn't wired here yet — add it once its screenId is known.
# services/vision's OBJECT-mode mat camera does NOT use this map — its
# destination screen(s) are whichever screen(s) have the "Object Recognition"
# experience pushed to them in the CMS (see getScreenIdsByTemplateKey in
# packages/db), the same "Push to screen" flow as any other experience.
CAMERA_SCREEN_MAP="camera-01:main-screen,camera-02:main-screen"

BETTER_AUTH_SECRET=CHANGE_ME
BETTER_AUTH_URL=http://localhost
NEXT_PUBLIC_APP_URL=http://localhost

NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WS_URL=/ws
NEXT_PUBLIC_WS_GATEWAY_URL=/ws
NEXT_PUBLIC_SCREENS_URL=/display

CORS_ORIGIN=http://localhost
MQTT_BROKER_URL=mqtt://mosquitto:1883
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_WS_PORT=9001

CASAMBI_NETWORK_ID=5

IR_ENABLED=true
IR_COMMAND_TOPIC=twt/av/ir/command
IR_ACK_TOPIC=twt/av/ir/ack
IR_STATUS_TOPIC=twt/av/ir/status
CRABCONTROLLER_URL=http://localhost:8000

SCREEN_ID=screen_experience_center_01

UPLOAD_DIR=/data/uploads
LOG_DIR=/data/logs

# Gmail attachment/link on-demand load (apps/api/src/services/gmail-ingest.ts,
# triggered by the "Load last 2 days" button in Email Media) — off unless
# GMAIL_INGEST_ENABLED is set. Requires a Google Workspace service account
# authorized for domain-wide delegation (scope: gmail.readonly) to impersonate
# GMAIL_IMPERSONATE_USER. See the plan doc for full setup steps.
GMAIL_INGEST_ENABLED=
GMAIL_IMPERSONATE_USER=hello@thewhitetusker.com
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/path/to/service-account.json

BROADCAST_SECRET=CHANGE_ME

# ─── Greet on arrival (apps/api/src/services/greeting) ───────────────────────
# Recognised visitors are greeted once per local day on main-screen (welcome
# screen + a spoken line). Needs the `welcome-screen` experience
# (`pnpm --filter @platform/db db:seed-welcome`) and migrations 0039-0041. Also
# gated by the "welcome trigger" toggle in the CMS (/api/vision-trigger).
# Production: set these in .env.production (the api container's env_file), never
# in the compose `environment:` block. Copy this section's lines into .env.production
# (every line is a documented default; keep GREETING_ENABLED=false until the rollout
# reaches that step). Details: .doc/greeting.md; rollout order: .doc/greeting-rollout.md.
# OFF by default (anything but 1/true/yes/on): with it off nothing from the
# greeting feature is loaded or run, and PERSON_PRESENT keeps pushing the welcome
# screen exactly as before. On: VISITOR_DETECTED is the only trigger and
# PERSON_PRESENT no longer pushes the welcome screen.
GREETING_ENABLED=false
# IANA timezone that defines "today" and the part of day (never the host's own).
GREETING_TZ=Asia/Kolkata
# Unknown (unnamed) visitors: screen = welcome screen only, no voice;
# generic = screen + "<Part of day>. Welcome."; off = nothing (still counted as greeted).
GREET_UNKNOWN=screen
# Who speaks: screen = the TV's browser (speechSynthesis); off = log only; travis = not implemented yet.
GREETING_VOICE=screen
# A visitor is "in the room" if last seen within this many seconds (rename/merge greetings).
GREET_PRESENCE_WINDOW_SECONDS=120
# Part of day: before AFTERNOON hour = morning, before EVENING hour = afternoon, else evening.
GREET_AFTERNOON_HOUR=12
GREET_EVENING_HOUR=17
# People recognised within this window are greeted together in one line (0 = no grouping).
GREET_BATCH_WINDOW_MS=3000
# More names than this are greeted as "everyone".
GREET_MAX_NAMES=4
# The welcome screen reverts to the screen's default media after this many seconds.
WELCOME_SCREEN_DURATION_SECONDS=20
# When main-screen is busy (a live whiteboard, blanked over content, or any content other than
# the default media) nothing is shown or said, and the visitor gets a 'skipped' row that blocks
# every greeting for them for the rest of the day (next day: normal). It never overwrites an
# earlier greeting. all = every busy reason; whiteboard = only a live whiteboard (for the other
# reasons the visitor counts as greeted, silently).
GREET_BUSY_SKIPS_DAY=all
# How visitors are named aloud: full = the name as entered (control characters stripped,
# capped at 40 characters; placeholders like "unknown"/"test" are treated as an unknown
# visitor), first = first word only, none = never say a name.
GREET_NAME_MODE=full
# Optional: ask the TV to use a specific speechSynthesis voice by name (exact, or a part of it,
# e.g. "Heera"). If it is not installed the TV falls back to en-IN, then any English voice.
# GREETING_VOICE_NAME=
# An arrival is greeted only if the sighting is this fresh: the event's own timestamp, and (plus
# the vision service's 30 s write cooldown) the visitor's last_seen on the database clock.
# Stops a replayed or old event greeting someone who has already left.
GREET_ARRIVAL_FRESH_SECONDS=30
# visitor_greeting rows older than this many days are deleted daily (only while greetings are on).
GREETING_RETENTION_DAYS=30
# Welcome video sound, decided by the API (the player has no env var of its own).
# Unset: muted while GREETING_ENABLED is on (the spoken greeting owns the audio),
# untouched while it is off. true / false force it either way, in both cases.
# WELCOME_VIDEO_MUTED=

# TRAVIS's room-mic voice engine authenticates to /api/internal/voice/* with
# this shared secret (header x-voice-secret) — see apps/api/src/routes/voice-internal.ts.
# Kept separate from BROADCAST_SECRET so it can be rotated/revoked independently.
VOICE_AGENT_SECRET=CHANGE_ME

# Comma-separated screenId / device id (not names) allow-lists, checked after
# name resolution. When set, the voice-internal routes reject any resolved
# target outside these lists even with a valid VOICE_AGENT_SECRET — the room
# mic has no per-user login, so this is the only boundary between "anyone
# near it" and every screen/device in the building. Strongly recommended to
# set explicitly (list every current screen/device id) rather than leave
# blank, even for a single-room deployment — update it when devices/screens
# are added or removed. Fetch current ids from GET /api/internal/voice/devices
# and /screens.
VOICE_AGENT_ALLOWED_SCREEN_IDS=
VOICE_AGENT_ALLOWED_DEVICE_IDS=

INTERNAL_API_URL=http://localhost:4000

NEXT_PUBLIC_VISION_WS_URL=/vision/ws

VISION_SERVER_MODEL_PATH=/app/models/production/coster-v1.pt
VISION_SERVER_DEVICE=cuda:0
VISION_SERVER_CONF_THRESHOLD=0.4

# The Browser page needs no API keys or services: it embeds the real sites and
# lets Google do the searching. Large sites refuse to render inside a frame, so
# machines that use it need the Frame Unlock extension installed once —
# see tools/frame-unlock-extension/README.md.

# The lock's entity id is auto-discovered from Home Assistant's own entity
# list (there's exactly one lock.* entity in a normal deployment) — only
# HA_URL/HA_TOKEN are required. Set HA_ENTITY_ID to override auto-discovery
# for a deployment with more than one lock entity.
HA_URL=http://localhost:8123
HA_TOKEN=CHANGE_ME
HA_ENTITY_ID=

# ─── Flight Garden template (apps/api/src/routes/flight-simulation.ts) ───────
# Every variable below is optional. The template renders on its own generated
# traffic and the committed still image without any of them; each one only
# upgrades a scene from simulated to live.

# Weather scene + the wind-driven video playback rate, via WeatherAPI. The key
# stays server-side: the browser calls GET /api/flight-simulation/wind, which
# only accepts location ids from the allowlist in
# apps/api/src/services/flight-locations.ts.
WEATHERAPI_KEY=

# Attendance scene — present/absent/late headcounts proxied from trava-app so
# its key never reaches the browser. The workspace id is not secret but is kept
# here so callers cannot point the endpoint at another workspace.
TRAVA_ATTENDANCE_API_URL=
TRAVA_ATTENDANCE_API_KEY=
TRAVA_ATTENDANCE_WORKSPACE_ID=

# The garden's 4K video renders. They are ~1GB each and deliberately not in the
# repo: they live in a private Cloudflare R2 bucket, and
# GET /api/flight-simulation/garden-video 302s to a short-lived presigned URL
# (see apps/api/src/services/flight-video.ts). The bucket's CORS policy must
# allow the display's origin, or the WebGL texture upload taints the canvas and
# the garden falls back to the still image. Leave unset to skip video entirely.
FLIGHT_R2_ACCESS_KEY_ID=
FLIGHT_R2_SECRET_ACCESS_KEY=
FLIGHT_R2_BUCKET=
FLIGHT_R2_ENDPOINT=
FLIGHT_R2_REGION=auto
