{
  "name": "cms-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "description": "Production-grade digital signage, CMS, and IoT platform monorepo",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm infra:up && turbo run build --filter=./packages/* --force && turbo run dev",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @platform/db db:generate",
    "db:migrate": "pnpm --filter @platform/db db:migrate",
    "db:push": "pnpm --filter @platform/db db:push",
    "db:studio": "pnpm --filter @platform/db db:studio",
    "db:backup": "powershell -ExecutionPolicy Bypass -File infra/scripts/backup-db.ps1",
    "backup:media": "powershell -ExecutionPolicy Bypass -File infra/scripts/backup-media.ps1",
    "backup:full": "powershell -ExecutionPolicy Bypass -File infra/scripts/backup-full.ps1",
    "infra:build": "docker compose --env-file .env -f infra/docker/docker-compose.local.yml build",
    "infra:up": "docker compose --env-file .env -f infra/docker/docker-compose.local.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.local.yml down",
    "infra:logs": "docker compose -f infra/docker/docker-compose.local.yml logs -f",
    "infra:restart": "docker compose --env-file .env -f infra/docker/docker-compose.local.yml restart",
    "prod:build": "docker compose --env-file .env.production -f infra/docker/docker-compose.yml build",
    "prod:up": "docker compose --env-file .env.production -f infra/docker/docker-compose.yml up -d",
    "prod:down": "docker compose -f infra/docker/docker-compose.yml down",
    "healthcheck": "curl -sf http://localhost/health || echo UNHEALTHY"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "turbo": "^2.9.15",
    "typescript": "^5.4.5"
  }
}
