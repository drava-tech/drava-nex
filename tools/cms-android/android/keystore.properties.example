# Copy to android/keystore.properties (gitignored) and fill in.
#
# Create the keystore once, and keep the .jks OUTSIDE this repo:
#   keytool -genkey -v -keystore ec-cms-release.jks -alias ec-cms \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# Back the .jks up somewhere safe. If it is lost, no future build can update
# the app in place on devices that already have it installed — every tablet
# needs a manual uninstall and reinstall.

# Absolute path — a relative one resolves against android/app/, not android/.
storeFile=E:/EC/keystores/ec-cms-release.jks
storePassword=
keyAlias=ec-cms
keyPassword=
