# ─── Team Member Setup (shared host database) ─────────────────────────────────
#
# For developers who clone this repo and want to run it locally with `pnpm dev`
# while sharing the HOST machine's Postgres + (optional) MQTT over the LAN.
# You do NOT install or seed your own database.
#
# Quick start:
#   1. cp .env.team.example .env
#   2. cp apps/cms/.env.example     apps/cms/.env
#   3. cp apps/screens/.env.example apps/screens/.env.local
#   4. Fill in <HOST_IP> and <DB_PASSWORD> below (ask the host owner for the password)
#   5. pnpm install
#   6. pnpm dev   →  open http://localhost:3000
#
# Finding the host address:
#   The host runs:
#     (Get-NetIPAddress -AddressFamily IPv4 | Where-Object { $_.InterfaceAlias -notlike "*Loopback*" }).IPAddress
#   Current host IP: 192.168.1.250  ← use this as <HOST_IP> unless told otherwise.
#
# ⚠  Do NOT run `pnpm db:migrate` / `db:push` / any seed script.
#    The host owns the schema and data — migrations are their job.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ─── PostgreSQL (the HOST machine's shared DB) ────────────────────────────────
# Replace <HOST_IP> with the host's LAN IP and <DB_PASSWORD> with the password
# the host owner gives you (it is NOT stored in this repo).
POSTGRES_HOST=<HOST_IP>
POSTGRES_PORT=5432
POSTGRES_DB=cms_db
POSTGRES_USER=cms_app
POSTGRES_PASSWORD=<DB_PASSWORD>

# If the password contains '@', encode it as %40 in the URL below.
DATABASE_URL=postgresql://cms_app:<DB_PASSWORD>@<HOST_IP>:5432/cms_db

# ─── Better Auth (your local CMS instance) ────────────────────────────────────
# Generate your own secret: openssl rand -hex 32   (each dev can use their own;
# accounts live in the shared DB, password hashes are portable across instances).
BETTER_AUTH_SECRET=<GENERATE_WITH_openssl_rand_-hex_32>
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost

# ─── App Ports ────────────────────────────────────────────────────────────────
API_PORT=4000
CMS_PORT=3000
SCREENS_PORT=3001

# ─── Next.js Public URLs (you run your own apps — keep localhost) ─────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
NEXT_PUBLIC_WS_GATEWAY_URL=ws://localhost:4000/ws
# CMS live-mirror iframe targets the local screens dev server
NEXT_PUBLIC_SCREENS_URL=http://localhost:3001

# ─── Real-Time Broadcast (between YOUR local CMS and API) ─────────────────────
# Any value works as long as it matches in apps/cms/.env; defaults to "dev-secret".
BROADCAST_SECRET=dev-secret
INTERNAL_API_URL=http://localhost:4000

# ─── MQTT Broker (OPTIONAL in dev) ────────────────────────────────────────────
# The host does NOT publish MQTT on the LAN by default, so leave this as localhost.
# IoT/MQTT features simply stay "unavailable" in dev unless you run a local broker.
CORS_ORIGIN=http://localhost:3000,http://localhost
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_WS_PORT=9001

# ─── Screen Player ────────────────────────────────────────────────────────────
SCREEN_ID=screen_experience_center_01

# ─── File Storage (local to your machine) ─────────────────────────────────────
UPLOAD_DIR=C:/cms-uploads
LOG_DIR=C:/cms-logs
