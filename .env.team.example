# ─── Team Member Setup ────────────────────────────────────────────────────────
#
# This file is for developers who clone the repo from GitHub and want to
# connect to the HOST machine's shared Docker PostgreSQL + MQTT broker.
#
# Steps:
#   1. Copy this file to .env
#         cp .env.team.example .env
#   2. Replace every <HOST_IP> below with the host's address (see options)
#   3. pnpm install
#   4. pnpm dev
#   5. Open http://localhost:3000
#
# Finding the host address:
#
#   Use the host PC's IPv4 address — hostname strings (like "ec-cms") can
#   resolve to IPv6 which node-postgres does not handle correctly.
#
#   Host runs this to find their IPv4:
#     (Get-NetIPAddress -AddressFamily IPv4 | Where-Object { $_.InterfaceAlias -notlike "*Loopback*" }).IPAddress
#   → e.g. 192.168.1.50   ← use THAT as <HOST_IP>
#
#   For a stable IP: ask the host to set a DHCP reservation on the router
#   so their PC always gets the same address.
#
# ⚠  Do NOT run `pnpm db:migrate` or `pnpm db:push`.
#    The host machine owns the database schema — migrations are their job.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Node Environment ─────────────────────────────────────────────────────────
NODE_ENV=development

# ─── PostgreSQL (points to host machine) ──────────────────────────────────────
# Replace <HOST_IP> with the host PC's LAN IP, e.g. 192.168.1.50
POSTGRES_HOST=<HOST_IP>
POSTGRES_PORT=5432
POSTGRES_DB=cms_db
POSTGRES_USER=cms_app
POSTGRES_PASSWORD=Ec-Db_2021_Digital_1331

DATABASE_URL=postgresql://cms_app:Ec-Db_2021_Digital_1331@<HOST_IP>:5432/cms_db

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Your local CMS instance — keep as localhost
BETTER_AUTH_SECRET=pOWWjeTWofkDlcCSpu3gYGPqqkshMhac
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Add your own hostname/IP here so the host's auth server trusts your requests
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost,http://ec-cms

# ─── App Ports ────────────────────────────────────────────────────────────────
API_PORT=4000
CMS_PORT=3000
SCREENS_PORT=3001

# ─── Next.js Public URLs ──────────────────────────────────────────────────────
# Each developer runs their own API — keep as localhost
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_WS_GATEWAY_URL=http://localhost:4000

# ─── MQTT Broker (points to host machine) ─────────────────────────────────────
# Replace <HOST_IP> with the host PC's LAN IP
CORS_ORIGIN=http://localhost
MQTT_BROKER_URL=mqtt://<HOST_IP>:1883
MQTT_HOST=<HOST_IP>
MQTT_PORT=1883
MQTT_WS_PORT=9001

# ─── Screen Player ────────────────────────────────────────────────────────────
SCREEN_ID=screen_experience_center_01

# ─── File Storage (local to your machine) ─────────────────────────────────────
# Change these to any folder on your own machine
UPLOAD_DIR=C:/cms-uploads
LOG_DIR=C:/cms-logs
