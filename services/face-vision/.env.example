# ─── Database ─────────────────────────────────────────────────────────────────
# Postgres DSN. The server MUST have the pgvector extension installed
# (image pgvector/pgvector:pg16, or postgresql-16-pgvector on a bare install).
# Dev DB: 192.168.0.250 — prod: the compose postgres on the host.
FACE_DATABASE_URL=postgresql://user:password@192.168.0.250:5432/cms_platform

# ─── Camera ───────────────────────────────────────────────────────────────────
# "opencv" (any USB webcam — dev default) or "realsense" (Intel RealSense, prod)
FACE_CAMERA_BACKEND=opencv
FACE_OPENCV_DEVICE_INDEX=0

# RealSense colour stream (only used when FACE_CAMERA_BACKEND=realsense)
FACE_RS_WIDTH=1280
FACE_RS_HEIGHT=720
FACE_RS_FPS=30

# ─── Model ────────────────────────────────────────────────────────────────────
# insightface pack: SCRFD detector + ArcFace 512-d recognizer.
# Auto-downloads (~300 MB) into FACE_MODEL_ROOT on first start.
FACE_MODEL_PACK=buffalo_l
FACE_MODEL_ROOT=./models
FACE_DET_SIZE=640
FACE_DET_SCORE_THRESHOLD=0.5

# ─── Identification ───────────────────────────────────────────────────────────
# Faces with a bbox shorter side below this many pixels are background and ignored.
FACE_MIN_BBOX_PX=80

# Cosine-distance ceiling for "same person" (pgvector <=>). Lower = stricter.
# Tune with scripts/enroll_test.py against real photos.
FACE_MATCH_MAX_DISTANCE=0.5

# Seconds between last_seen writes for the same visitor (anti-spam debounce).
FACE_COOLDOWN_SECONDS=30

# ─── Tracking ─────────────────────────────────────────────────────────────────
FACE_TRACK_IOU_THRESHOLD=0.3
FACE_TRACK_MAX_MISSES=15
FACE_TRACK_CONFIRM_FRAMES=3
FACE_REVERIFY_SECONDS=60

# ─── Images ───────────────────────────────────────────────────────────────────
# Where cropped face JPEGs are written; the API serves them from the same dir.
# Prod: E:/EC/cms-platform-data/faces
FACE_IMAGE_DIR=./data/faces

# Days before scripts/purge_images.py deletes a face JPEG (embedding is kept).
FACE_IMAGE_RETENTION_DAYS=30
