# ─── Model ────────────────────────────────────────────────────────────────────
# Path to the trained YOLO .pt model (relative to monorepo root or absolute)
VISION_MODEL_PATH=services/product-vision/models/production/smart-glasses-v1.pt

# Minimum confidence score (0.0–1.0) to report a detection
VISION_CONFIDENCE_THRESHOLD=0.80

# ─── Camera ───────────────────────────────────────────────────────────────────
# Camera backend: "opencv" (USB webcam, default) or "realsense" (Intel RealSense)
VISION_CAMERA_BACKEND=opencv

# Logical camera ID sent in every detection event (must match your CMS screen setup)
VISION_CAMERA_ID=camera-01

# RealSense stream resolution (only used when VISION_CAMERA_BACKEND=realsense)
VISION_RS_WIDTH=1280
VISION_RS_HEIGHT=720
VISION_RS_FPS=30

# OpenCV device index (only used when VISION_CAMERA_BACKEND=opencv)
VISION_OPENCV_DEVICE_INDEX=0

# ─── Detection Stability ──────────────────────────────────────────────────────
# Consecutive frames with a detection before firing PRODUCT_DETECTED
VISION_STABILITY_FRAMES=5

# Consecutive empty frames before firing PRODUCT_LOST
VISION_LOST_FRAMES=10

# ─── CMS Gateway ──────────────────────────────────────────────────────────────
# WebSocket URL of the CMS API (apps/api)
CMS_WEBSOCKET_URL=ws://192.168.0.250:4000/ws/
