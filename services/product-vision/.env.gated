# Model B — template-gated instance. Same shape as .env, but only runs
# detection while VISION_SCREEN_ID's active experience has VISION_GATE_TEMPLATE_KEY.
# See services/product-vision/.env for full comments on each variable.

# ─── Model ────────────────────────────────────────────────────────────────────
# Point this at Model B's own trained weights once available. Placeholder below
# reuses the existing model so the container has something valid to load.
VISION_MODEL_PATH=models/production/coster-v1.pt

VISION_CONFIDENCE_THRESHOLD=0.80

# ─── Camera ───────────────────────────────────────────────────────────────────
VISION_CAMERA_BACKEND=opencv
# Must be a DIFFERENT physical camera than camera-01 (two processes can't share
# one webcam) — matched to docker-compose.yml's product-vision-gated /dev/video1
# device mapping. Also add "camera-02:<screenId>" to CAMERA_SCREEN_MAP below.
VISION_CAMERA_ID=camera-02
VISION_OPENCV_DEVICE_INDEX=0

# ─── Detection Stability ──────────────────────────────────────────────────────
VISION_STABILITY_FRAMES=5
VISION_LOST_FRAMES=15
VISION_HOLD_PRODUCT=true
VISION_DEBUG_PRODUCT=true

# ─── Template gating (required for this instance) ─────────────────────────────
# The screen this camera is mapped to (must match its CAMERA_SCREEN_MAP entry).
VISION_SCREEN_ID=screen-2
# Detection only runs while screen-2's active experience has this templateKey.
# One of: portfolio | live-stream | product-showcase (packages/types/src/index.ts).
VISION_GATE_TEMPLATE_KEY=product-showcase

# ─── CMS Gateway ──────────────────────────────────────────────────────────────
# Overridden by docker-compose.yml's `environment:` block when run via Docker.
CMS_WEBSOCKET_URL=ws://192.168.1.250/ws/
