# deps) — never shared with the face pipeline's, see object_detection/README.md.
.venv-test/
__pycache__/
*.pyc
data/
# Keep the models/ dir (placeholder) but ignore the downloaded packs inside it.
models/*
!models/.gitkeep
models/**/*.zip

# Model packs are downloaded locally by InsightFace and are not committed.
