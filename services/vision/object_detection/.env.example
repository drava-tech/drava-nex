# services/vision/object_detection/.env — copy to .env (gitignored).
# Read by BOTH server/settings.py (VISION_SERVER_*) and training/config.py
# (VISION_MODEL_PATH + camera vars), so one file covers local dev end to end.

# ── Inference server (python -m vision.object_detection.server) ───────────────
# Path to the .pt weight. Relative paths resolve against your shell's cwd —
# use an absolute path or run from services/vision/object_detection.
VISION_SERVER_MODEL_PATH=models/production/coster-v1.pt
# Must start with "cuda" — CPU fallback is disabled on purpose.
VISION_SERVER_DEVICE=cuda:0
VISION_SERVER_CONF_THRESHOLD=0.4
# Optional startup integrity check; see models/production/checksums.txt.
# VISION_SERVER_MODEL_SHA256=
VISION_SERVER_MAX_FRAME_BYTES=1048576
VISION_SERVER_MIN_FRAME_INTERVAL_MS=100
VISION_SERVER_MAX_CONNECTIONS=4
VISION_SERVER_INFERENCE_TIMEOUT_MS=2000
VISION_SERVER_PORT=8000

# ── Training scripts (scripts/*, training/config.py) ──────────────────────────
# Weight used by evaluate.py / export.py / live_test.py.
VISION_MODEL_PATH=models/production/coster-v1.pt
VISION_CONFIDENCE_THRESHOLD=0.80

# Local camera used by capture_images.py / test_camera.py / live_test.py.
VISION_CAMERA_BACKEND=opencv
VISION_OPENCV_DEVICE_INDEX=0
VISION_RS_WIDTH=1280
VISION_RS_HEIGHT=720
VISION_RS_FPS=30
