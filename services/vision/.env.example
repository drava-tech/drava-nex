# ─── Required ─────────────────────────────────────────────────────────────────
# Base URL of the Hono API (for the internal live-event relay).
VISION_API_URL=http://localhost:4000
# Shared secret — must match BROADCAST_SECRET on the API (x-broadcast-secret).
BROADCAST_SECRET=your-secret-here
# Postgres DSN. The server MUST have the pgvector extension installed
# (image pgvector/pgvector:pg16, or postgresql-16-pgvector on a bare install).
# Dev DB: 192.168.0.250 — prod: the compose postgres on the host.
VISION_DATABASE_URL=postgresql://user:password@192.168.0.250:5432/cms_platform
# Master switch for the identity path (DB connection, face matching/
# enrollment, visitor table writes, face-crop images). Set to false to run
# presence-trigger-only — no biometric data is captured or stored anywhere.
VISION_DB_ENABLED=true

# ─── Camera fleet ─────────────────────────────────────────────────────────────
# One entry per camera. mode: "PEOPLE" (face detection) or "OBJECT" (product/
# mat detection). backend: "opencv" (USB webcam, dev) or "realsense" (Intel
# RealSense, prod). OBJECT cameras can override width/height/fps per-camera
# (e.g. the mat camera wants 1280x800 for tiled inference, vs the face
# default of 1280x720) — only that camera's subprocess gets the override.
VISION_CAMERAS=[{"id":"cam-entrance","mode":"PEOPLE","backend":"opencv","index":0},{"id":"cam-mat","mode":"OBJECT","backend":"realsense","width":1280,"height":800}]

# RealSense colour stream default (only used by realsense-backed cameras;
# OBJECT cameras can override via VISION_CAMERAS' width/height/fps, above)
VISION_RS_WIDTH=1280
VISION_RS_HEIGHT=720
VISION_RS_FPS=30

# ─── Face model ───────────────────────────────────────────────────────────────
# insightface pack: SCRFD detector + ArcFace 512-d recognizer.
# Auto-downloads (~300 MB) into VISION_MODEL_ROOT on first start.
VISION_MODEL_PACK=buffalo_l
VISION_MODEL_ROOT=./models
VISION_DET_SIZE=640
VISION_DET_SCORE_THRESHOLD=0.4

# ─── Identification ───────────────────────────────────────────────────────────
# Faces with a bbox shorter side below this many pixels are background and ignored
# for identity matching/enrollment (visitor table) — keep strict for data quality.
VISION_MIN_BBOX_PX=80
# Separate, looser floor for the identity-agnostic PERSON_PRESENT signal (the
# welcome-screen trigger) — lets "someone is there" fire from farther away than
# is reliable for actually identifying them. Defaults to VISION_MIN_BBOX_PX.
VISION_PRESENCE_MIN_BBOX_PX=80
# Cosine-distance ceiling for "same person" (pgvector <=>). Lower = stricter.
# Tune with scripts/enroll_test.py against real photos.
VISION_MATCH_MAX_DISTANCE=0.5
# Seconds between last_seen writes for the same visitor (anti-spam debounce).
VISION_COOLDOWN_SECONDS=30
# Seconds between PERSON_PRESENT events (identity-agnostic — drives the
# welcome-screen trigger, independent of the visitor match/enroll cooldown).
VISION_PRESENCE_COOLDOWN_SECONDS=5

# ─── Tracking ─────────────────────────────────────────────────────────────────
VISION_TRACK_IOU_THRESHOLD=0.3
VISION_TRACK_MAX_MISSES=15
VISION_TRACK_CONFIRM_FRAMES=3
VISION_REVERIFY_SECONDS=60

# ─── Images ───────────────────────────────────────────────────────────────────
# Where cropped face JPEGs are written; the API serves them from the same dir.
# Prod: E:/EC/cms-platform-data/faces
VISION_IMAGE_DIR=./data/faces
# Days before scripts/purge_images.py deletes a face JPEG (embedding is kept).
VISION_IMAGE_RETENTION_DAYS=30

# ─── Object detection (mat product detector) ───────────────────────────────────
# Trained YOLO weights (ultralytics .pt). See models/latticelane-detector.pt.
VISION_OBJECT_MODEL_PATH=./models/latticelane-detector.pt
VISION_OBJECT_CONF_THRESHOLD=0.25
VISION_OBJECT_IOU_THRESHOLD=0.6
# Calibrated mat polygon — run `python scripts/calibrate_mat.py` once per
# physical camera/mat setup to generate this file (click the mat's 4 corners).
VISION_OBJECT_MAT_ROI_PATH=./data/mat_roi.json
