# OPTIONAL — Linux-host deployment only.
# The primary deployment runs natively on the Windows host: Docker Desktop on
# Windows cannot pass USB / RealSense cameras through to a container, and the
# RTX 3090 is directly usable from Windows via onnxruntime-gpu. Build this only
# when the stack moves to a Linux host with the camera SDKs and the nvidia
# container toolkit available. Face-detection (PEOPLE) mode only.
#
# Object detection is a SEPARATE image built from the same context —
# object_detection/Dockerfile.server. Never merge the two: onnxruntime-gpu and
# torch bundle conflicting CUDA/cuDNN runtimes. Both share .dockerignore.
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-server.txt .
RUN pip install --no-cache-dir -r requirements-server.txt

# The `vision` package sits at /app/vision so `python -m vision` resolves.
COPY . /app/vision

# Bake the insightface pack into the image so the container is self-contained.
# The models dir is gitignored — pre-download it on the build machine first
# (run the service once, or `python -c "from insightface.app import FaceAnalysis; FaceAnalysis(name='buffalo_l', root='./models')"`).
ENV VISION_MODEL_ROOT=/app/vision/models
ENV VISION_IMAGE_DIR=/data/faces
ENV PYTHONPATH=/app

RUN useradd -m appuser && mkdir -p /data/faces && chown -R appuser:appuser /app /data/faces
USER appuser

CMD ["python", "-m", "vision"]
