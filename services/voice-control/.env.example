# Copy to services/voice-control/.env (gitignored), KEY=value lines.
# Values here win over the repo-root .env, which is also read.

# Shared secret for apps/api's /api/voice-control/* (header x-travis-vc-key).
# Must be the same value as TRAVIS_VC_KEY in the API's environment (root .env).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRAVIS_VC_KEY=

# Travis's voice. Without the key, commands still run but Travis stays silent.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=bIHbv24MWmeRgasZH58o
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Optional: API base URL (default http://127.0.0.1:4000 from config).
# VOICE_CONTROL_CMS_URL=http://192.168.1.250:4000
